 # --- 1. System deps + VAPT arsenal (apt only, no pip) --------------------------
 RUN apt-get update && \
     apt-get install -y --no-install-recommends \
-    ca-certificates curl wget git zsh jq \
+    ca-certificates curl wget git zsh jq libcap2-bin \
