# =============================================================================
# AEGIS Hypervisor 4.0 — container environment
# 1) cp .env.example .env
# 2) fill in AEGIS_OPENAI_API_KEY (marked <RESTORE-YOUR-API-KEY>)
# 3) gitignore .env — it must never be committed, shared, or baked into images
# =============================================================================

# --- Model gateway (internal; verified reachable during Test-3) ---------------
AEGIS_OPENAI_BASE_URL=<ENDPOINT>
AEGIS_MODEL=<MODEL>

# --- API key (RESTORE — stripped from this shared kit) -------------------------
AEGIS_OPENAI_API_KEY=<APIKEY>

# --- Optional: pin the model's real context window -----------------------------
# Test-3 ran on the conservative 32768-token fallback (cisai-ultra is not in
# the context-window registry). Only set this if you know the true window —
# an oversized pin risks provider-side truncation.
AEGIS_CONTEXT_WINDOW_TOKENS=200000
AEGIS_MAX_OUTPUT_TOKENS=3072
AEGIS_MAX_OUTPUT_TOKENS_CEILING=8192
AEGIS_LLM_MAX_ATTEMPTS=3
AEGIS_LLM_TOTAL_TIMEOUT_S=240
# --- Egress proxying ------------------------------------------------------------
# Do NOT set HTTP_PROXY/HTTPS_PROXY unless you want MODEL traffic proxied too:
# the stdlib HTTP client honors them (proxychains wraps CLI tools only).
AEGIS_TURN_BUDGET_S=5400
AEGIS_SUBAGENT_MAX_TURNS=16
AEGIS_AGENT_TIMEOUT_S=7200
AEGIS_LLM_IDLE_TIMEOUT_S=180
