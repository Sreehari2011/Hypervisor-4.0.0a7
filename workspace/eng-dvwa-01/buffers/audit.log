   561	function dvwaExternalLinkUrlGet( $pLink,$text=null ) {
   562		if(is_null( $text ) || $text == "") {
   563			return '<a href="' . $pLink . '" target="_blank">' . $pLink . '</a>';
   564		}
   565		else {
   566			return '<a href="' . $pLink . '" target="_blank">' . $text . '</a>';
   567		}
   568	}
