    89			$httponly = false;
    90			$samesite = "";
    91		}
    92	
    93		$maxlifetime = 86400;
    94		$secure = false;
    95		$domain = parse_url($_SERVER['HTTP_HOST'], PHP_URL_HOST);
    96	
    97		/*
    98		 * Need to do this as you can't update the settings of a session
    99		 * while it is open. So check if one is open, close it if needed
   100		 * then update the values and start it again.
   101		*/
   102		if (session_status() == PHP_SESSION_ACTIVE) {
   103			session_write_close();
   104		}
   105	
   106		session_set_cookie_params([
   107			'lifetime' => $maxlifetime,
   108			'path' => '/',
   109			'domain' => $domain,
   110			'secure' => $secure,
   111			'httponly' => $httponly,
   112			'samesite' => $samesite
   113		]);
   114	
   115		/*
   116		 * We need to force a new Set-Cookie header with the updated flags by updating
