   667	// Token functions --
   668	function checkToken( $user_token, $session_token, $returnURL ) {  # Validate the given (CSRF) token
   669		global $_DVWA;
   670	
   671		if (array_key_exists("disable_authentication", $_DVWA) && $_DVWA['disable_authentication']) {
   672			return true;
   673		}
   674	
   675		if( $user_token !== $session_token || !isset( $session_token ) ) {
   676			dvwaMessagePush( 'CSRF token is incorrect' );
   677			dvwaRedirect( $returnURL );
   678		}
   679	}
   680	
   681	function generateSessionToken() {  # Generate a brand new (CSRF) token
   682		if( isset( $_SESSION[ 'session_token' ] ) ) {
   683			destroySessionToken();
   684		}
   685		$_SESSION[ 'session_token' ] = md5( uniqid() );
   686	}
   687	
   688	function destroySessionToken() {  # Destroy any session with the name 'session_token'
   689		unset( $_SESSION[ 'session_token' ] );
   690	}
   691	
   692	function tokenField() {  # Return a field for the (CSRF) token
   693		return "<input type='hidden' name='user_token' value='{$_SESSION[ 'session_token' ]}' />";
   694	}
