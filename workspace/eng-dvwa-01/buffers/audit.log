   643	// XSS Stored guestbook function --
   644	function dvwaGuestbook() {
   645		$query  = "SELECT name, comment FROM guestbook";
   646		$result = mysqli_query($GLOBALS["___mysqli_ston"],  $query );
   647	
   648		$guestbook = '';
   649	
   650		while( $row = mysqli_fetch_row( $result ) ) {
   651			if( dvwaSecurityLevelGet() == 'impossible' ) {
   652				$name    = htmlspecialchars( $row[0] );
   653				$comment = htmlspecialchars( $row[1] );
   654			}
   655			else {
   656				$name    = $row[0];
   657				$comment = $row[1];
   658			}
   659	
   660			$guestbook .= "<div id=\"guestbook_comments\">Name: {$name}<br />" . "Message: {$comment}<br /></div>\n";
   661		}
   662		return $guestbook;
   663	}
   664	// -- END (XSS Stored guestbook)
