   596	function dvwaDatabaseConnect() {
   597		global $_DVWA;
   598		global $DBMS;
   599		//global $DBMS_connError;
   600		global $db;
   601		global $sqlite_db_connection;
   602	
   603		if( $DBMS == 'MySQL' ) {
   604			if( !@($GLOBALS["___mysqli_ston"] = mysqli_connect( $_DVWA[ 'db_server' ],  $_DVWA[ 'db_user' ],  $_DVWA[ 'db_password' ], "", $_DVWA[ 'db_port' ] ))
   605			|| !@((bool)mysqli_query($GLOBALS["___mysqli_ston"], "USE " . $_DVWA[ 'db_database' ])) ) {
   606				//die( $DBMS_connError );
   607				dvwaLogout();
   608				dvwaMessagePush( 'Unable to connect to the database.<br />' . mysqli_error($GLOBALS["___mysqli_ston"]));
   609				dvwaRedirect( DVWA_WEB_PAGE_TO_ROOT . 'setup.php' );
   610			}
   611			// MySQL PDO Prepared Statements (for impossible levels)
   612			$db = new PDO('mysql:host=' . $_DVWA[ 'db_server' ].';dbname=' . $_DVWA[ 'db_database' ].';port=' . $_DVWA['db_port'] . ';charset=utf8', $_DVWA[ 'db_user' ], $_DVWA[ 'db_password' ]);
   613			$db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
   614			$db->setAttribute(PDO::ATTR_EMULATE_PREPARES, false);
   615		}
   616		elseif( $DBMS == 'PGSQL' ) {
   617			//$dbconn = pg_connect("host={$_DVWA[ 'db_server' ]} dbname={$_DVWA[ 'db_database' ]} user={$_DVWA[ 'db_user' ]} password={$_DVWA[ 'db_password' ]}"
   618			//or die( $DBMS_connError );
   619			dvwaMessagePush( 'PostgreSQL is not currently supported.' );
   620			dvwaPageReload();
   621		}
   622		else {
   623			die ( "Unknown {$DBMS} selected." );
   624		}
   625	
   626		if ($_DVWA['SQLI_DB'] == SQLITE) {
   627			$location = DVWA_WEB_PAGE_TO_ROOT . "database/" . $_DVWA['SQLITE_DB'];
   628			$sqlite_db_connection = new SQLite3($location);
   629			$sqlite_db_connection->enableExceptions(true);
   630		#	print "sqlite db setup";
   631		}
   632	}
   633	
